# Secrets of the hosted app on Streamlit Community Cloud.
# Paste this, filled in, into: App settings > Secrets. Never commit the filled-in version
# (.streamlit/secrets.toml is git-ignored). Keep the keys at the top level: only top-level
# secrets are passed on to the app as environment variables, which is how config.py and
# history_backup.py read them.

# OpenRouter API key. Set a credit limit on this key at openrouter.ai as well.
OPENROUTER_API_KEY = "sk-or-..."

# Private repository that keeps the user histories (owner/name), and a fine-grained GitHub
# token with "Contents: read and write" on that repository only.
HISTORY_REPO = "your-github-name/rules-assistant-history"
GITHUB_TOKEN = "github_pat_..."
