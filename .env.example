# Copy to .env and fill in your key. .env is git-ignored.
OPENROUTER_API_KEY=

# Optional: copy of the user histories in a private GitHub repository (history_backup.py).
# Leave empty to keep the histories in data/users/ only.
HISTORY_REPO=
GITHUB_TOKEN=

# Secret that signs the login cookie (auth.py). Any long random text, e.g. the output of
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
# Empty: logins are only remembered until the app is restarted.
AUTH_COOKIE_KEY=
