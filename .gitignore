# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environment (managed by uv)
.venv/

# Secrets — never commit API keys
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Data. The knowledge base (data/library/) and its search index (data/index/) ARE committed,
# so the hosted app starts with a ready base library. Only add documents that may be shared
# (the invented sample documents, or with permission), never copyrighted ones such as DIN
# standards. Not committed:
# data/users/ holds the saved conversations of logged-in users (backed up to a separate
# private repository instead, see history_backup.py), data/raw/ is a local scratch folder.
data/users/
data/raw/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code local-only settings
.claude/settings.local.json
