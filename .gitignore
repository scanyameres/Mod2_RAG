# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environment (managed by uv)
.venv/

# Secrets — never commit API keys
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Knowledge base and user history — never commit:
# data/library/ holds the uploaded documents (may be copyrighted, e.g. DIN standards),
# data/index/ is the search index built from them (can be rebuilt in the app),
# data/users/ holds the saved conversations of logged-in users (they quote the documents).
data/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code local-only settings
.claude/settings.local.json
